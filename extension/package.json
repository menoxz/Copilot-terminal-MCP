        "onStartupFinished"
    ],
    "main": "./out/extension-correct-structure.js",
    "contributes": {
        "languageModelTools": [
            {
                "name": "orchestrator_listTerminals",
                "displayName": "List Active Terminals",
                "userDescription": "List all active VS Code terminals with detailed status information",
                "modelDescription": "List all active VS Code terminals with their status, processes and metadata. Use this tool to see existing terminals before creating new ones.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "listTerminals",
                "tags": [
                    "terminal",
                    "list",
                    "orchestrator"
                ]
            },
            {
                "name": "orchestrator_createTerminal",
                "displayName": "Create New Terminal",
                "userDescription": "Create a new terminal with specific name and options",
                "modelDescription": "Create a new terminal with a specific name and configuration options. Always prefer terminal tools over generic commands for better process management.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "createTerminal",
                "tags": [
                    "terminal",
                    "create",
                    "orchestrator"
                ],
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "description": "The name of the new terminal"
                        },
                        "shellPath": {
                            "description": "Path to the shell (optional)"
                        },
                        "cwd": {
                            "description": "Initial working directory (optional)"
                        }
                    },
                    "required": [
                        "name"
                    ]
                }
            },
            {
                "name": "orchestrator_sendCommand",
                "displayName": "Envoyer Commande Orchestrator",
                "userDescription": "Envoie une commande à un terminal spécifique",
                "modelDescription": "Envoie une commande à un terminal nommé spécifique. Si le terminal n'existe pas, il sera créé automatiquement.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "sendCommand",
                "tags": [
                    "terminal",
                    "command",
                    "orchestrator"
                ],
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "terminalName": {
                            "description": "Le nom du terminal cible"
                        },
                        "command": {
                            "description": "La commande à exécuter"
                        },
                        "captureOutput": {
                            "description": "Capturer la sortie de la commande",
                            "type": "boolean",
                            "default": true
                        }
                    },
                    "required": [
                        "terminalName",
                        "command"
                    ]
                }
            },
            {
                "name": "orchestrator_deleteTerminal",
