{
    "name": "copilot-terminal-mcp-server",
    "version": "1.0.1",
    "description": "Advanced MCP Server for terminal management with GitHub Copilot integration",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "copilot-terminal-mcp-server": "bin/cli.js",
        "copilot-terminal-install": "bin/install.js",
        "copilot-terminal-setup": "bin/install.js"
    },
    "files": [
        "dist/**/*",
        "bin/**/*",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsc --watch",
        "prepublishOnly": "npm run build",
        "postinstall": "node bin/postinstall.js",
        "test": "node --test",
        "clean": "rm -rf dist",
        "install-mcp": "node bin/install.js install",
        "uninstall-mcp": "node bin/install.js uninstall",
        "status": "node bin/install.js status",
        "package": "node bin/publish.js",
        "publish-test": "npm publish --dry-run",
        "publish-npm": "npm publish"
    },
    "keywords": [
        "mcp",
        "server",
        "terminal",
        "copilot",
        "github",
        "vscode",
        "automation",
        "cli",
        "developer-tools",
        "model-context-protocol"
    ],
    "author": {
        "name": "Jean-Luc KOUMAGLO",
        "email": "jeanlukou@gmail.com",
        "url": "https://github.com/jeanluc-dev"
    },
    "license": "MIT",
    "homepage": "https://github.com/jeanluc-dev/copilot-terminal-mcp-server",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jeanluc-dev/copilot-terminal-mcp-server.git"
    },
    "bugs": {
        "url": "https://github.com/jeanluc-dev/copilot-terminal-mcp-server/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^0.4.0",
        "chalk": "^5.6.0",
        "detect-port": "^2.1.0",
        "find-process": "^2.0.0",
        "nanoid": "^5.1.5",
        "strip-ansi": "^7.1.0",
        "tree-kill": "^1.2.2"
    },
    "devDependencies": {
        "@types/detect-port": "^1.3.5",
        "@types/find-process": "^1.1.0",
        "@types/node": "^20.0.0",
        "typescript": "^5.9.2"
    }
}
