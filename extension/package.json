    "description": "Professional terminal management for VS Code with 29 advanced tools - GitHub Copilot integration",
    "version": "1.2.0",
    "publisher": "LUX-TECH",
    "author": "Jean-Luc KOUMAGLO <jeanlukou@gmail.com>",
    "license": "MIT",
    "homepage": "https://github.com/jeanluc-dev/terminal-orchestrator",
    "bugs": {
        "url": "https://github.com/jeanluc-dev/terminal-orchestrator/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jeanluc-dev/terminal-orchestrator.git"
    },
    "keywords": [
        "copilot",
        "language-model",
        "terminal",
        "orchestrator",
        "tools",
